    <script>
        // Initialize Lucide Icons on Load
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            initScrollReveal();
        });

        // Toggle Mobile Navigation
        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            menu.classList.toggle('hidden');
        }

        // Animate On Scroll (Intersection Observer for ultra smooth reveal)
        function initScrollReveal() {
            const reveals = document.querySelectorAll('.reveal');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('active');
                    }
                });
            }, {
                threshold: 0.12
            });

            reveals.forEach(el => observer.observe(el));
        }

        // Terminal Interaktif Logic
        function triggerTerminalCmd(cmd) {
            const output = document.getElementById('terminalOutput');
            let res = '';

            if (cmd === 'mustafa') {
                res = `<div class="text-cyan-300">
                    [MUSTAFA LOG]<br>
                    - Nama: Mustafa Andhika Wirajaya (Kelas X-K)<br>
                    - Status: Suka Komputer & Laptop sejak Kelas 6 SD.<br>
                    - OS Utama: Arch Linux (Pengguna aktif sejak tahun 2025).<br>
                    - Spesialisasi: System Tweak, Terminal Bash, Custom Kernel/Ricing.
                </div>`;
            } else if (cmd === 'endra') {
                res = `<div class="text-blue-300">
                    [ENDRA LOG]<br>
                    - Nama: Endra Adhibrata (Kelas X-K)<br>
                    - Status: Hobi Menggeledah Hardware PC sejak Kelas 4 SD (2015).<br>
                    - Keahlian: Bongkar Pasang Komponen, Thermal Repaste, Cable Management.<br>
                    - Pengalaman: 11+ Tahun Eksplorasi Fisik Hardware PC.
                </div>`;
            } else if (cmd === 'arch') {
                res = `<div class="text-cyan-400">
                    [ARCH LINUX SYSTEM INFO]<br>
                    OS: Arch Linux x86_64 (2025 Release)<br>
                    Kernel: Linux 6.12.x-arch1-1<br>
                    Uptime: 99.9% Laptop Daily Driver Mustafa
                </div>`;
            } else if (cmd === 'hardware') {
                res = `<div class="text-blue-400">
                    [HARDWARE ASSEMBLY CHECKLIST]<br>
                    1. Motherboard & CPU Socket Inspector<br>
                    2. RAM Dual Channel Slot Alignment<br>
                    3. GPU PCIe Lock & Power Pin Cable<br>
                    4. PSU Modular Power Distribution
                </div>`;
            } else if (cmd === 'clear') {
                output.innerHTML = '';
                return;
            } else {
                res = `<p class="text-red-400">Perintah '${cmd}' tidak ditemukan. Ketik 'help' untuk panduan.</p>`;
            }

            output.innerHTML += `
                <div class="my-2">
                    <span class="text-cyan-400">guest@xk-tech:~$</span> <span class="text-white">${cmd}</span>
                    <div class="mt-1 pl-2 border-l-2 border-slate-700">${res}</div>
                </div>
            `;

            const body = document.getElementById('terminalBody');
            body.scrollTop = body.scrollHeight;
        }

        function handleTerminalSubmit(e) {
            e.preventDefault();
            const input = document.getElementById('terminalInput');
            const val = input.value.trim().toLowerCase();
            if (val) {
                triggerTerminalCmd(val);
                input.value = '';
            }
        }

        // Copy Contact Utility
        function copyContact(text, label) {
            document.execCommand('copy');
            showToast(`${label} berhasil disalin!`);
        }

        function sendMessage(e) {
            e.preventDefault();
            showToast("Pesan Anda berhasil terkirim ke Duo X-K!");
            e.target.reset();
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastText').innerText = msg;
            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3000);
        }
    </script>
